                      <properties>
                        <property
                          containsID="true"
                          dataType="System.String"
                          description="Derived Column Expression"
                          name="Expression">([ISNULL](#{Package\Load Dim_Category\Flat File Source.Outputs[Flat File Source Output].Columns[Category]}) || [TRIM]([REPLACE](#{Package\Load Dim_Category\Flat File Source.Outputs[Flat File Source Output].Columns[Category]},"\t","")) == "" || [TRIM]([REPLACE](#{Package\Load Dim_Category\Flat File Source.Outputs[Flat File Source Output].Columns[Category]},"\t","")) == "-") ? (DT_WSTR,100)"Unknown" : [TRIM]([REPLACE](#{Package\Load Dim_Category\Flat File Source.Outputs[Flat File Source Output].Columns[Category]},"\t",""))</property>
                        <property
                          containsID="true"
                          dataType="System.String"
                          description="Derived Column Friendly Expression"
                          expressionType="Notify"
                          name="FriendlyExpression">(ISNULL(Category) || TRIM(REPLACE(Category,"\t","")) == "" || TRIM(REPLACE(Category,"\t","")) == "-") ? (DT_WSTR,100)"Unknown" : TRIM(REPLACE(Category,"\t",""))</property>
