                <component
                  refId="Package\Foreach Loop Container\Load Dim_Ticket\Read Silver"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                  description="OLE DB Source"
                  name="Read Silver"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=17.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT
    s.ticket_id,
    s.summary,
    s.view_status,
    CONVERT(INT, CONVERT(CHAR(8), s.date_submitted, 112)) AS date_submitted_key,
    CASE WHEN r.resolution_date IS NOT NULL
         THEN CONVERT(INT, CONVERT(CHAR(8), r.resolution_date, 112)) END AS date_resolution_key,
    CASE WHEN COALESCE(st.is_open, 1) = 1
         THEN DATEDIFF(DAY, s.date_submitted, s.date_loaded) END AS age_open,
    CASE WHEN r.resolution_date IS NOT NULL
         THEN DATEDIFF(DAY, s.date_submitted, r.resolution_date) END AS age_resolution
FROM silver.Ticket_Clean s
LEFT JOIN dbo.Dim_Status st  ON st.status_name = s.status
LEFT JOIN dbo.Dim_Ticket t   ON t.ticket_id = s.ticket_id
LEFT JOIN dbo.Dim_Date   d   ON d.date_key = t.date_resolution_key
CROSS APPLY (SELECT CASE WHEN st.is_open = 0
                         THEN COALESCE(d.full_date, s.updated) END AS resolution_date) r
WHERE s.date_loaded = (SELECT MAX(date_loaded) FROM silver.Ticket_Clean);</property>
                    <property
                      dataType="System.String"
                      description="The variable that contains the SQL command to be executed."
                      name="SqlCommandVariable"></property>
                    <property
                      dataType="System.Int32"
                      description="Specifies the column code page to use when code page information is unavailable from the data source."
                      name="DefaultCodePage">1252</property>
                    <property
                      dataType="System.Boolean"
                      description="Forces the use of the DefaultCodePage property value when describing character data."
                      name="AlwaysUseDefaultCodePage">false</property>
                    <property
                      dataType="System.Int32"
                      description="Specifies the mode used to access the database."
                      name="AccessMode"
