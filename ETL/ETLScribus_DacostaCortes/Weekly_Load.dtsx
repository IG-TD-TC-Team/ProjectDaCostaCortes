          <ProjectItem
            Name="ScriptMain.cs"
            Encoding="UTF8"><![CDATA[#region Namespaces
using System;
using System.Collections.Generic;
using System.Data;
using System.IO;
using System.Net;
using System.Text.RegularExpressions;
using Microsoft.SqlServer.Dts.Runtime;
#endregion

namespace ST_ee04cb553bd641f480da6ad5388d7c4d
{
    [Microsoft.SqlServer.Dts.Tasks.ScriptTask.SSISScriptTaskEntryPointAttribute]
    public partial class ScriptMain : Microsoft.SqlServer.Dts.Tasks.ScriptTask.VSTARTScriptObjectModelBase
    {
        public void Main()
        {
            string baseUrl = @"http://teachingse.hevs.ch/csvFiles/";
            string dir = @"C:\ScribusDW\csv";
            DateTime last = Convert.ToDateTime(Dts.Variables["User::LastLoadedDate"].Value);
            Directory.CreateDirectory(dir);

            try
            {
                using (WebClient wc = new WebClient())
                {
                    string html = wc.DownloadString(baseUrl);
                    SortedSet<string> names = new SortedSet<string>();
                    foreach (Match m in Regex.Matches(html, @"scribus-dump-\d{4}-\d{2}-\d{2}\.csv"))
                        names.Add(m.Value);
                    if (names.Count == 0) throw new Exception("No scribus-dump file found at " + baseUrl);

                    foreach (string n in names)
                    {
                        DateTime d = DateTime.ParseExact(n.Substring(13, 10), "yyyy-MM-dd", null);
                        string dest = Path.Combine(dir, n);
                        if (d <= last || File.Exists(dest)) continue;
                        wc.DownloadFile(baseUrl + n, dest + ".part");
                        File.Move(dest + ".part", dest);
                    }
                }
                Dts.TaskResult = (int)ScriptResults.Success;
            }
            catch (Exception ex)
            {
                Dts.Events.FireError(0, "Download CSV files", ex.Message, "", 0);
                Dts.TaskResult = (int)ScriptResults.Failure;
            }
        }

