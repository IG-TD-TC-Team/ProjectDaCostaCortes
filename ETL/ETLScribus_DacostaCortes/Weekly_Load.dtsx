                <component
                  refId="Package\Foreach Loop Container\Load Fact_Ticket_Snapshot\Read Silver"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                  description="OLE DB Source"
                  name="Read Silver"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=17.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT
    t.ticket_key,
    CONVERT(INT, CONVERT(CHAR(8), s.date_loaded, 112)) AS date_loaded_key,
    CONVERT(INT, CONVERT(CHAR(8), s.updated, 112))     AS date_updated_key,
    COALESCE(st.status_key, -1)          AS status_key,
    COALESCE(rs.resolution_key, -1)      AS resolution_key,
    COALESCE(ca.category_key, -1)        AS category_key,
    COALESCE(se.severity_key, -1)        AS severity_key,
    COALESCE(pr.priority_key, -1)        AS priority_key,
    COALESCE(a.assigned_to_key, -1)      AS assigned_to_key,
    COALESCE(rp.reporter_key, -1)        AS reporter_key,
    COALESCE(re.reproducibility_key, -1) AS reproducibility_key,
    COALESCE(pj.project_key, -1)         AS project_key,
    COALESCE(pv.version_key, -1)         AS product_version_key,
    COALESCE(fv.version_key, -1)         AS fixed_in_version_key,
    COALESCE(o.os_key, -1)               AS os_key,
    COALESCE(pl.platform_key, -1)        AS platform_key
FROM silver.Ticket_Clean s
JOIN dbo.Dim_Ticket t              ON t.ticket_id = s.ticket_id
LEFT JOIN dbo.Dim_Status st        ON st.status_name = s.status
LEFT JOIN dbo.Dim_Resolution rs    ON rs.resolution_name = s.resolution
LEFT JOIN dbo.Dim_Category ca      ON ca.category_name = s.category
LEFT JOIN dbo.Dim_Severity se      ON se.severity_name = s.severity
LEFT JOIN dbo.Dim_Priority pr      ON pr.priority_name = s.priority
LEFT JOIN dbo.Dim_Assigned_To a    ON a.assigned_to_name = s.assigned_to
LEFT JOIN dbo.Dim_Reporter rp      ON rp.reporter_name = s.reporter
LEFT JOIN dbo.Dim_Reproducibility re ON re.reproducibility_name = s.reproducibility
LEFT JOIN dbo.Dim_Project pj       ON pj.project_name = s.project
LEFT JOIN dbo.Dim_Version pv       ON pv.version_name = s.product_version
LEFT JOIN dbo.Dim_Version fv       ON fv.version_name = s.fixed_in_version
LEFT JOIN dbo.Dim_OS o             ON o.os = s.os AND o.os_version = s.os_version
LEFT JOIN dbo.Dim_Platform pl      ON pl.platform_name = s.platform
WHERE s.date_loaded = (SELECT MAX(date_loaded) FROM silver.Ticket_Clean)
  AND NOT EXISTS (SELECT 1 FROM dbo.Fact_Ticket_Snapshot f
                  WHERE f.ticket_key = t.ticket_key
                    AND f.date_loaded_key = CONVERT(INT, CONVERT(CHAR(8), s.date_loaded, 112)));</property>
